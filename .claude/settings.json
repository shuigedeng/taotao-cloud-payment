{
  "permissions": {
    "read": ["**/src/**/*.java", "**/src/**/*.yml", "**/src/**/*.yaml", "**/src/**/*.properties", "**/src/**/*.sql", "**/src/**/*.proto", "**/src/**/*.json", "build.gradle", "settings.gradle", "gradle/**", "*.md", ".opencode/*.json"],
    "write": ["**/src/**/*.java", "**/src/**/*.yml", "**/src/**/*.yaml", "**/src/**/*.properties", "**/src/**/*.sql", "**/src/**/*.proto", "build.gradle", "settings.gradle", "gradle/**"],
    "execute": ["gradlew", "git", "java", "docker"],
    "network": ["localhost:8080", "localhost:3306", "localhost:8848", "localhost:6379"]
  },
  "allowedTools": ["read", "write", "edit", "bash", "glob", "grep", "search", "question", "websearch"],
  "bash": {
    "allowedCommands": ["gradlew", "git", "java", "docker", "curl", "cat", "echo", "mkdir", "cp", "mv", "rm"]
  },
  "git": {
    "autoCommit": false,
    "requireTests": true,
    "commitMessageTemplate": "type(scope): description"
  },
  "build": {
    "tool": "gradle",
    "compileCommand": "gradlew compileJava",
    "testCommand": "gradlew test",
    "buildCommand": "gradlew build -x test",
    "lintCommands": ["gradlew checkstyleMain", "gradlew spotlessCheck", "gradlew pmdMain", "gradlew spotbugsMain"]
  }
}
