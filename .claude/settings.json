{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(**/src/**/*.java)",
      "Edit(**/src/**/*.yml)",
      "Edit(**/src/**/*.yaml)",
      "Edit(**/src/**/*.properties)",
      "Edit(**/src/**/*.sql)",
      "Edit(**/src/**/*.proto)",
      "Edit(build.gradle)",
      "Edit(settings.gradle)",
      "Edit(gradle/**)",
      "Bash(gradlew *)",
      "Bash(git *)",
      "Bash(java *)",
      "Bash(docker *)",
      "Bash(curl *)",
      "WebFetch(domain:localhost)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf /)",
      "Bash(wget *)"
    ]
  },
  "env": {
    "JAVA_TOOL_OPTIONS": "--enable-preview",
    "GRADLE_OPTS": "-Dorg.gradle.jvmargs=--enable-preview"
  }
}
